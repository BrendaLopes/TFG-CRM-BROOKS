@startuml
title Estado de la propuesta


state "BORRADOR" as BORRADOR
state "ENVIADA" as ENVIADA
state "EN REVISION" as EN_REVISION
state "ACEPTADA" as ACEPTADA
state "RECHAZADA" as RECHAZADA

[*] --> BORRADOR : crear propuesta

BORRADOR --> ENVIADA : enviar al cliente

ENVIADA --> EN_REVISION : el cliente solicita cambios
ENVIADA --> ACEPTADA : el cliente acepta
ENVIADA --> RECHAZADA : el cliente rechaza

EN_REVISION --> ENVIADA : enviar nueva versión
EN_REVISION --> RECHAZADA : descartar propuesta

ACEPTADA --> [*]
RECHAZADA --> [*]

BORRADOR : Propuesta en elaboración
ENVIADA : Propuesta enviada al cliente
EN_REVISION : Propuesta en revisión por cambios solicitados
ACEPTADA : Propuesta aceptada por el cliente
RECHAZADA : Propuesta rechazada o descartada

@enduml