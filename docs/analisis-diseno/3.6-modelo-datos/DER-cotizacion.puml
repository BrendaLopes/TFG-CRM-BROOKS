@startuml
title DER — Proceso de cotización

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 100
skinparam ranksep 100

skinparam class {
  BackgroundColor #F3F7FD
  BorderColor #6C8EBF
}

entity SolicitudServicio {
  * id : UUID <<PK>>
  --
  * oportunidadId : UUID <<FK>>
  tipoServicio : VARCHAR
  frecuenciaServicio : VARCHAR
  direccionServicio : TEXT
  restriccionesHorario : TEXT
  observaciones : TEXT
  requiereFichaSeguridad : BOOLEAN
  accesoVehiculo : BOOLEAN
}

entity Cotizacion {
  * id : UUID <<PK>>
  --
  * solicitudId : UUID <<FK>>
  fechaGeneracion : TIMESTAMP
  estado : ENUM
  distanciaCalculada : DECIMAL
  tiempoEstimadoServicio : INTEGER
  totalSugerido : DECIMAL
  totalFinal : DECIMAL
  observaciones : TEXT
}

entity ItemServicioSolicitado {
  * id : UUID <<PK>>
  --
  * solicitudId : UUID <<FK>>
  * residuoId : UUID <<FK>>
  cantidadEstimada : DECIMAL
  unidadMedida : ENUM
  destinoFinal : VARCHAR
  acondicionamiento : VARCHAR
  descripcionDetallada : TEXT
}

entity ItemCotizacion {
  * id : UUID <<PK>>
  --
  * cotizacionId : UUID <<FK>>
  tarifaBaseId : UUID <<FK>>
  itemServicioId : UUID <<FK>>
  descripcion : VARCHAR
  cantidad : DECIMAL
  unidad : VARCHAR
  importeTransporteAplicado : DECIMAL
  importeDestinoFinalAplicado : DECIMAL
  franquiciaAplicada : DECIMAL
  importeExcedenteAplicado : DECIMAL
  precioSugerido : DECIMAL
  precioFinal : DECIMAL
  subtotal : DECIMAL
  ajusteManual : BOOLEAN
  justificacionAjuste : TEXT
}

entity Residuo {
  * id : UUID <<PK>>
  --
  codigoInterno : VARCHAR
  grupo : VARCHAR
  nombre : VARCHAR
  codigoIbama : VARCHAR
  clase : ENUM
  activo : BOOLEAN
}

entity TarifaBase {
  * id : UUID <<PK>>
  --
  * residuoId : UUID <<FK>>
  codigoServicio : VARCHAR
  destinoFinal : VARCHAR
  unidadMedida : ENUM
  importeTransporte : DECIMAL
  importeDestinoFinal : DECIMAL
  franquicia : DECIMAL
  importeExcedente : DECIMAL
  vigencia : DATE
  activa : BOOLEAN
}

SolicitudServicio "1" -right-> "0..*" Cotizacion : origina
SolicitudServicio "1" -down-> "1..*" ItemServicioSolicitado : contiene

Cotizacion "1" -down-> "1..*" ItemCotizacion : desglosa

ItemCotizacion "0..*" .left.> "0..1" ItemServicioSolicitado : referencia
ItemCotizacion "0..*" .down.> "0..1" TarifaBase : usa tarifa

ItemServicioSolicitado "0..*" -down-> "1" Residuo : es de tipo
Residuo "1" -right-> "0..*" TarifaBase : tiene tarifas

@enduml