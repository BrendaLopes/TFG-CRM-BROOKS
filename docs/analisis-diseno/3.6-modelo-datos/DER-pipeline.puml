@startuml
title DER — Pipeline comercial

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 100
skinparam ranksep 100

skinparam class {
  BackgroundColor #F3F7FD
  BorderColor #6C8EBF
}

entity Usuario {
  * id : UUID <<PK>>
  --
  nombre : VARCHAR
  email : VARCHAR <<UNIQUE>>
  rol : ENUM
  activo : BOOLEAN
}

entity Lead {
  * id : UUID <<PK>>
  --
  * usuarioId : UUID <<FK>>
  clienteId : UUID <<FK>>
  nombreEmpresa : VARCHAR
  nombreContacto : VARCHAR
  telefono : VARCHAR
  email : VARCHAR
  canalEntrada : ENUM
  origen : VARCHAR
  descripcionInicial : TEXT
  estado : ENUM
  motivoDescarte : TEXT
  fechaCreacion : TIMESTAMP
  fechaCualificacion : TIMESTAMP
}

entity Cliente {
  * id : UUID <<PK>>
  --
  nombre : VARCHAR
  documentoFiscal : VARCHAR
  numeroRegistroSILC : VARCHAR
  segmento : VARCHAR
  direccion : TEXT
}

entity Contacto {
  * id : UUID <<PK>>
  --
  * clienteId : UUID <<FK>>
  nombre : VARCHAR
  cargo : VARCHAR
  telefono : VARCHAR
  email : VARCHAR
}

entity Oportunidad {
  * id : UUID <<PK>>
  --
  * leadId : UUID <<FK>> <<UNIQUE>>
  clienteId : UUID <<FK>>
  * usuarioId : UUID <<FK>>
  estado : ENUM
  prioridad : ENUM
  tipoContrato : VARCHAR
  motivoCierre : TEXT
  fechaCreacion : TIMESTAMP
  fechaCierre : TIMESTAMP
}

entity HistorialSeguimiento {
  * id : UUID <<PK>>
  --
  * oportunidadId : UUID <<FK>>
  fecha : TIMESTAMP
  tipo : ENUM
  comentario : TEXT
  fechaProximoContacto : TIMESTAMP
}

entity Propuesta {
  * id : UUID <<PK>>
  --
  * oportunidadId : UUID <<FK>>
  * cotizacionId : UUID <<FK>>
  fechaEmision : TIMESTAMP
  fechaEnvio : TIMESTAMP
  version : INTEGER
  estado : ENUM
}

entity OrdenServicio {
  * id : UUID <<PK>>
  --
  * oportunidadId : UUID <<FK>> <<UNIQUE>>
  fechaGeneracion : TIMESTAMP
  tipoServicio : VARCHAR
  frecuenciaServicio : VARCHAR
  direccionServicio : TEXT
  condicionPago : VARCHAR
  observaciones : TEXT
  numeroOrdenSILC : VARCHAR
  dataExecucao : DATE
  unidadeOperacional : VARCHAR
}

Usuario "1" -right-> "0..*" Lead : registra
Lead "0..*" -right-> "0..1" Cliente : se vincula a
Cliente "1" -right-> "1..*" Contacto : tiene

Lead "1" -down-> "0..1" Oportunidad : origina
Cliente "0..1" -down-> "0..*" Oportunidad : asociada a
Usuario "1" -down-> "0..*" Oportunidad : gestiona

Oportunidad "1" -left-> "0..*" HistorialSeguimiento : tiene
Oportunidad "1" -down-> "0..*" Propuesta : genera
Oportunidad "1" -right-> "0..1" OrdenServicio : genera si ganada

@enduml