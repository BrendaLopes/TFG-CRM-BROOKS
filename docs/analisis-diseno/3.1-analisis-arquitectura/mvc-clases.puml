@startuml
title Diagrama de clases del análisis de arquitectura
top to bottom direction
skinparam PackageBorderColor #444444
skinparam PackageBackgroundColor #FAFAFA
skinparam defaultFontSize 11
hide stereotype

skinparam class {
  BackgroundColor<<B>> #fff2cc
  BorderColor<<B>> #d6b656
  BackgroundColor<<C>> #d5e8d4
  BorderColor<<C>> #82b366
  BackgroundColor<<E>> #dae8fc
  BorderColor<<E>> #6c8ebf
}

package "Views"  {
  class LoginView <<B>>
  class PipelineView <<B>>
  class RegistroLeadView <<B>>
  class FichaOportunidadView <<B>>
  class SolicitudServicioView <<B>>
  class FormularioCotizacionView <<B>>
  class PropuestaView <<B>>
  class OrdenServicioView <<B>>
  class TarifasView <<B>>
}

package "Controllers" {
  class RegistrarLeadController <<C>>
  class ActualizarLeadController <<C>>
  class GestionarOportunidadController <<C>>
  class RecogerDatosServicioController <<C>>
  class GenerarCotizacionController <<C>>
  class AjustarPreciosController <<C>>
  class GenerarPropuestaController <<C>>
  class RegistrarInteraccionesController <<C>>
  class CerrarOportunidadController <<C>>
  class GenerarOrdenServicioController <<C>>
  class GestionarTarifasController <<C>>
  class ConfigurarFormularioController <<C>>
}

package "Models" {
  class Usuario <<E>>
  class Lead <<E>>
  class Cliente <<E>>
  class Contacto <<E>>
  class Oportunidad <<E>>
  class HistorialSeguimiento <<E>>
  class SolicitudServicio <<E>>
  class ItemServicioSolicitado <<E>>
  class Cotizacion <<E>>
  class ItemCotizacion <<E>>
  class Propuesta <<E>>
  class OrdenServicio <<E>>
  class Residuo <<E>>
  class TarifaBase <<E>>
}

@enduml