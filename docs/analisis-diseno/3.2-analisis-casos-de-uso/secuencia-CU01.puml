@startuml
title Diagrama de secuencia — CU-01 Registrar lead

skinparam shadowing false
skinparam sequenceArrowThickness 1.4
skinparam defaultFontSize 11
hide stereotype

skinparam participant {
  BackgroundColor<<B>> #fff2cc
  BorderColor<<B>> #d6b656
  BackgroundColor<<C>> #d5e8d4
  BorderColor<<C>> #82b366
  BackgroundColor<<E>> #dae8fc
  BorderColor<<E>> #6c8ebf
}

actor "Usuario de recepción\n/ Comercial" as Usuario

participant "RegistroLeadView" as View <<B>>
participant "RegistrarLeadController" as Ctrl <<C>>
participant "Contacto" as Contacto <<E>>
participant "Lead" as Lead <<E>>

Usuario -> View : introducir datos del lead
View -> Ctrl : registrarLead(datos, usuarioId)

Ctrl -> Contacto : buscarCoincidencias(email, telefono, documento)

alt posible duplicado
  Contacto --> Ctrl : contacto coincidente
  Ctrl --> View : mostrarAlertaDuplicado(contacto)
  View --> Usuario : solicita confirmación

  alt el usuario confirma el registro
    Usuario -> View : registrar de todas formas
    View -> Ctrl : confirmarRegistro(datos, usuarioId)
    Ctrl -> Lead : crear(datos, usuarioId)
    Lead --> Ctrl : lead creado
    Ctrl --> View : mostrarConfirmacion(lead)
    View --> Usuario : lead registrado
  else el usuario cancela
    Usuario -> View : cancelar registro
    View --> Usuario : registro cancelado
  end

else sin coincidencias
  Contacto --> Ctrl : sin coincidencias
  Ctrl -> Lead : crear(datos, usuarioId)
  Lead --> Ctrl : lead creado
  Ctrl --> View : mostrarConfirmacion(lead)
  View --> Usuario : lead registrado
end

@enduml